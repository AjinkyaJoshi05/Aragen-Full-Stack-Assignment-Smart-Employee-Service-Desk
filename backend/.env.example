PORT=5000
NODE_ENV=development

# Local Microsoft SQL Server (Windows Authentication Example)
DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=ServiceDeskDB;Trusted_Connection=yes;TrustServerCertificate=yes;

# Cloud SQL Server Parameters (Azure SQL / Remote SQL Server Example)
DB_SERVER=your-server.database.windows.net
DB_NAME=ServiceDeskDB
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
